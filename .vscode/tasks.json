{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "Compilar con CMake",
            "type": "shell",
            "command": "cmake",
            "args": [
                "-S", ".", "-B", "build", "-DCMAKE_BUILD_TYPE=Debug"
            ],
            "group": {
                "kind": "build",
                "isDefault": true
            },
            "presentation": {
                "echo": true,
                "reveal": "always",
                "focus": false,
                "panel": "shared"
            }
        },
        {
            "label": "Construir proyecto",
            "type": "shell",
            "command": "cmake",
            "args": [
                "--build", "build", "--", "-j4"
            ],
            "dependsOn": "Compilar con CMake",
            "group": "build",
            "presentation": {
                "echo": true,
                "reveal": "always",
                "focus": false,
                "panel": "shared"
            }
        },
        {
            "label": "Ejecutar LabProg",
            "type": "shell",
            "command": "./bin/LabProg",
            "group": "test",
            "presentation": {
                "echo": true,
                "reveal": "always",
                "focus": true,
                "panel": "new"
            }
        },
        {
            "label": "Limpiar compilación",
            "type": "shell",
            "command": "rm -rf build bin/LabProg",
            "group": "build",
            "presentation": {
                "echo": true,
                "reveal": "always",
                "focus": false,
                "panel": "shared"
            }
        }
    ]
}
