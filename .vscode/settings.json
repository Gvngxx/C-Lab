{
    "C_Cpp.default.configurationName": "MinGW64",
    "C_Cpp.intelliSenseEngine": "default",
    "C_Cpp.codeAnalysis.clangTidy.enabled": true,
    "[cpp]": {
        "editor.defaultFormatter": "ms-vscode.cpptools"
    },
    "[c]": {
        "editor.defaultFormatter": "ms-vscode.cpptools"
    },
    "files.exclude": {
        "**/.git": true,
        "**/.github": true,
        "**/.svn": true,
        "**/.hg": true,
        "**/.clangd": true,
        "**/CVS": true,
        "**/build": false,
        "**/bin": false,
        "**/sc": true,
        "**/imgui.ini": true,
        "**/mingw64": true
    }
}